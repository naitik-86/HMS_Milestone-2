# Copy to .env and fill in real values. Never commit the real .env file.

PORT=5000
NODE_ENV=production

# Used by post-payment redirects (subscriptionPlanController.js paymentSuccess/
# paymentFailure) to send the browser back to the frontend. If unset, those
# redirects break with "Cannot GET /api/v1/subscription/undefined/..." - this
# bit a real deployment, see docs/10-application-notes.md.
FRONTEND_URL=

# Comma-separated list of extra allowed CORS origins (localhost is always allowed).
# e.g. http://my-bucket.s3-website.ap-south-1.amazonaws.com,http://<ec2-ip>:8080
ALLOWED_ORIGINS=

# MongoDB connection string (see docs/04-mongodb-atlas-setup.md)
MONGO_URI=

# JWT signing secret — generate with: openssl rand -hex 64
JWT_SECRET=

# Super Admin Configuration (2-Step OTP Login Flow)
SUPER_ADMIN_MOBILE=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# AWS S3 (uploads bucket) — on EC2 this is provided automatically by the
# instance's IAM role (see docs/02-aws-credentials-and-iam.md). Only set
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY here for local development
# against a personal/dev AWS account.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# SMTP
SMTP_HOST=
SMTP_PORT=
SMTP_EMAIL=
SMTP_PASSWORD=
FROM_NAME=
FROM_EMAIL=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# PayU (subscription payments) - test/sandbox base URL is
# https://test.payu.in/_payment, production is https://secure.payu.in/_payment.
# SUCCESS_URL/FAILURE_URL must point at this backend's own public URL, e.g.
# http://<host>/api/v1/subscription/payment-success
PAYU_KEY=
PAYU_SALT=
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_BASE_URL=
PAYU_URL=
PAYU_SUCCESS_URL=
PAYU_FAILURE_URL=
