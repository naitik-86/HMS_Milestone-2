# Copy to .env and fill in real values. Never commit the real .env file.

PORT=5000
NODE_ENV=production

# MongoDB connection string (see docs/04-mongodb-atlas-setup.md)
MONGO_URI=

# JWT signing secret — generate with: openssl rand -hex 64
JWT_SECRET=

# Super Admin Configuration (2-Step OTP Login Flow)
SUPER_ADMIN_MOBILE=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# AWS S3 (uploads bucket) — on EC2 this is provided automatically by the
# instance's IAM role (see docs/02-aws-credentials-and-iam.md). Only set
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY here for local development
# against a personal/dev AWS account.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# SMTP
SMTP_HOST=
SMTP_PORT=
SMTP_EMAIL=
SMTP_PASSWORD=
FROM_NAME=
FROM_EMAIL=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
