# Copy this file to terraform.tfvars and fill in real values.
# terraform.tfvars is gitignored — never commit it.

aws_region   = "ap-south-1"
aws_profile  = "hms-admin"
project_name = "hms-testing"

instance_type       = "t3.micro"
ssh_public_key_path = "~/.ssh/hms-deploy-key.pub"

backend_container_port = 5000

# Bucket names must be globally unique across ALL of AWS.
# Suggested pattern: <project>-<purpose>-<random-suffix>
frontend_bucket_name = "hms-frontend-testing-a1b2c3"
uploads_bucket_name  = "hms-uploads-testing-a1b2c3"
